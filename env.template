# EmailBlast Environment Variables Template
# Copy this file to .env and fill in your actual values.
#
# Anything prefixed VITE_ is bundled into the public client JS — it is NOT secret.
# Put real secrets only in the server-side (non-VITE_) vars, which are read by the
# Vercel /api functions and by drizzle-kit, never by the browser.

# --- Neon (client-side: safe to expose) ---
VITE_NEON_DATA_API_URL=https://your-data-api.neon.tech
VITE_NEON_AUTH_URL=https://your-neon-auth-url

# --- Application ---
VITE_APP_URL=http://localhost:5173
VITE_TEMPO=false
# Optional: warn in Settings if sender email domain doesn't match
VITE_RESEND_FROM_DOMAIN=yourdomain.com

# ===========================================================================
# SERVER-ONLY SECRETS (never prefixed VITE_, never shipped to the browser)
# Set these in your Vercel project env / local .env for the /api functions.
# ===========================================================================

# Public URL of the deployed app (tracking links, unsubscribe, cron callbacks)
APP_URL=http://localhost:5173

# Neon Postgres connection string (drizzle-kit migrations + server functions)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Email sending (Resend)
RESEND_API_KEY=re_your-resend-api-key

# AI content + lead generation (Groq) — server-side only
GROQ_API_KEY=gsk_your-groq-api-key

# Lead scraping (Firecrawl) — server-side only; required for Web Scraper / Lead Finder
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Resend webhook signature verification (required in production)
RESEND_WEBHOOK_SECRET=whsec_your-webhook-secret

# Cron job protection (required in production)
CRON_SECRET=your-cron-secret

# Signed tracking/unsubscribe tokens (falls back to CRON_SECRET if unset)
TRACKING_SECRET=your-tracking-hmac-secret

# Server-side Neon Data API URL (for JWT validation in /api routes)
NEON_DATA_API_URL=https://your-data-api.neon.tech
NEON_AUTH_URL=https://your-neon-auth-url

