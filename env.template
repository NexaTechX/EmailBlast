# EmailBlast Environment Variables Template
# Copy this file to .env and fill in your actual values.
#
# Anything prefixed VITE_ is bundled into the public client JS — it is NOT secret.
# Put real secrets only in the server-side (non-VITE_) vars, which are read by the
# Vercel /api functions and by drizzle-kit, never by the browser.

# --- Neon (client-side: safe to expose) ---
VITE_NEON_DATA_API_URL=https://your-data-api.neon.tech
VITE_NEON_AUTH_URL=https://your-neon-auth-url

# --- Application ---
VITE_APP_URL=http://localhost:5173
VITE_TEMPO=false

# ===========================================================================
# SERVER-ONLY SECRETS (never prefixed VITE_, never shipped to the browser)
# Set these in your Vercel project env / local .env for the /api functions.
# ===========================================================================

# Neon Postgres connection string (drizzle-kit migrations + server functions)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Email sending (Resend)
RESEND_API_KEY=re_your-resend-api-key

# AI content + lead generation (Groq) — server-side only
GROQ_API_KEY=gsk_your-groq-api-key

# Lead scraping (Firecrawl) — ROTATED key, server-side only
FIRECRAWL_API_KEY=your-rotated-firecrawl-api-key

# Payments are deferred this pass; add Stripe/Creem secrets when re-enabled.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CREEM_API_KEY=
